# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Claude Code: the agent definitions are project config and are tracked;
# per-machine settings and approvals are not.
.claude/settings.local.json

# editor / OS litter
.DS_Store
__MACOSX/
*.swp
*~
.idea/
.vscode/

# logs and scratch output
*.log
nohup.out
scratch/
tmp/

# large or regenerable artefacts
data/
results/

# Same `dir/*` trick as runs/ below. The two baselines were trained on this VM
# and feed `p_high`/`pkd_pred` into the ranking composite, so the ranking is not
# reproducible without them — 3.6 MB, worth keeping. `abhack.train` rebuilds
# them, but only after scripts/fetch_data.sh restores data/raw. Weights bigger
# than a joblib (checkpoints, safetensors) stay out; see the patterns below.
models/*
!models/*.joblib

# `runs/*` rather than `runs/`, so git still descends into it for the exception
# below — it does not look inside an excluded *directory*.
runs/*

# …except BoltzGen, which ran off-box on JapanFold and is NOT reproducible on
# this VM: 1.4 MB of designed complexes plus the job manifest. Everything else
# under runs/ can be rebuilt from scripts/design.sh + scripts/refold.sh.
!runs/boltzgen/
*.ckpt
*.pt
*.safetensors
*.npz
designs/_probe.csv

# Intermediates of the ranking flow. All are seconds of CPU to rebuild from the
# design tables, which ARE tracked:
#   abhack.ranking rank designs/opt-s*.csv -o designs/opt-ranked.csv
#     → abhack.tickets → abhack.ranking merge
#     → abhack.submission build → scripts/validate.sh
# Tracked instead: the design tables themselves (`designs/opt-s*.csv`,
# `designs/denovo-vhh-s1.csv`), the measurements that cost GPU or an off-box job
# (`designs/epitope-*.csv`, `designs/af2ig-*.csv`), the exported structures, and
# the one file the organisers receive, `designs/submission.csv`.
designs/*.ranked.csv
designs/*-ranked.csv
designs/*-ranked-final.csv
designs/*-valid.csv
designs/*-with-epitope.csv

# per-seed submission drafts; the deliverable is designs/submission.csv
designs/*-submission.csv
designs/denovo_submission.csv

# smoke-test output — scripts/smoke_test.sh remakes both in ~5 min
designs/smoke.csv
designs/smoke_submission.csv

# structures dropped at the repo root while poking at things.
# Anything a module actually reads lives under data/ or specs/ and is
# fetched by scripts/fetch_data.sh; public PDB entries are re-downloadable.
/*.pdb
/*.cif

# third-party material, not ours to redistribute.
# data/ above covers the Apheris tutorial; re-fetch both with:
#   bash scripts/fetch_data.sh small
ai-antibodies-hackathon-apheris.pdf

# never commit platform credentials (Nebius/JapanFold keys).
# JapanFold reads $JAPANFOLD_API_KEY or ~/japanfold/japanfold.key — both
# outside the repo; these patterns are the backstop for a stray copy.
.env
.env.*
*.private.json
credentials*.json
*.key
*.pem

# secrets (keys loaded via env.sh)
.env.private
*.key
